# Port the HTTP + Socket.IO server listens on (Railway injects its own).
PORT=3000
# Comma-separated list of allowed browser origins. Unset = allow all (dev only).
# Vite hops to the next port when 5173 is busy; list the ones it may land on,
# or the browser drops the socket and the game hangs on "getting the round ready".
FRONTEND_URL=http://localhost:5173,http://localhost:5174,http://localhost:5175
NODE_ENV=development
# Rooms held in memory at once. Past it, room:create is refused with `server_full`
# instead of the process running out of memory and dropping every game. Default 500.
# MAX_ROOMS=500
# Development-only: force every round to use this 5-letter answer. Ignored when NODE_ENV=production.
# WORDRUSH_FIXED_WORD=ahora
