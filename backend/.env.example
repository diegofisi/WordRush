# Port the HTTP + Socket.IO server listens on (Railway injects its own).
PORT=3000
# Comma-separated list of allowed browser origins. Unset = allow all (dev only).
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
# Rooms held in memory at once. Past it, room:create is refused with `server_full`
# instead of the process running out of memory and dropping every game. Default 500.
# MAX_ROOMS=500
# Development-only: force every round to use this 5-letter answer. Ignored when NODE_ENV=production.
# WORDRUSH_FIXED_WORD=ahora

# --- BOSS-MODE (temporary; see docs/context/07-boss-removal.md) -------------
# The optional "challenge the fly" mode. Default on while it is being trialled;
# set to false and nothing of it is constructed or reachable.
# BOSS_MODE_ENABLED=true
# Ceilings for its brain threads, each holding a copy of the connectome
# (~90 MB). One decider is always warm; more boot when rooms are waiting and
# are released after 60 s idle. Streamers (one per watched panel) boot on
# demand and are released the same way.
# BOSS_DECIDERS=3
# BOSS_STREAMS=3
# --- end BOSS-MODE ---------------------------------------------------------
